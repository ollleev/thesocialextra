[Unit]
Description=thesocialextra verified encrypted recovery point
After=thesocialextra.service
Requires=thesocialextra.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/thesocialextra/current
Environment=BACKUP_REQUIRE_LIVE_WAL=true
ExecStart=/usr/bin/node ops/backup-job.mjs /var/lib/thesocialextra/app.sqlite /var/backups/thesocialextra /etc/thesocialextra-backup/backup.key
UMask=0077
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
InaccessiblePaths=/etc/thesocialextra
ReadOnlyPaths=/var/lib/thesocialextra /etc/thesocialextra-backup
ReadWritePaths=/var/backups/thesocialextra
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=16
LimitNOFILE=128
LimitFSIZE=2G
